{
  "name": "weststar-one",
  "private": true,
  "version": "3.0.0",
  "description": "Weststar ONE — MSP platform (TypeScript rebuild)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @ws/api db:migrate",
    "db:generate": "pnpm --filter @ws/api db:generate",
    "seed:admin": "pnpm --filter @ws/api seed:admin",
    "import:legacy": "pnpm --filter @ws/api import:legacy",
    "start": "pnpm --filter @ws/api start"
  }
}
