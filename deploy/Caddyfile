# Cloudflare (optional, see deploy/cloudflare.sh). These are Cloudflare's published addresses (cloudflare.com/ips).
# When a request arrives from one of them, the visitor's real address is in CF-Connecting-IP; from anyone else that
# header is ignored, so it can't be faked. Without Cloudflare nothing changes: the visitor is whoever connected.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare_only) {
	# CLOUDFLARE_ONLY=on: refuse anyone who reaches the server directly instead of through Cloudflare.
	@direct {
		expression `"{$CLOUDFLARE_ONLY:off}" == "on"`
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	handle @direct {
		abort
	}
}

# Automatic HTTPS (Let's Encrypt). DOMAIN is the staff app; PORTAL_DOMAIN (optional) is the client portal's
# own address, e.g. portal.weststarmsp.com — clients never see the staff app's address.
{$DOMAIN} {$PORTAL_DOMAIN} {
	import cloudflare_only
	encode zstd gzip
	header -Server

	# Settings › Import accepts the old backup and uploads folder (can be several GB);
	# everything else is limited to 100 MB.
	@import path /settings/import/*
	request_body @import {
		max_size 60GB
	}
	@other not path /settings/import/*
	request_body @other {
		max_size 100MB
	}

	# On the portal's own address every page is a portal page: / → /client-portal/, /tickets/ → /client-portal/tickets/ …
	@portalhost expression `{http.request.host} != "{$DOMAIN}"`
	handle @portalhost {
		@notportal not path /client-portal/* /static/* /health/
		rewrite @notportal /client-portal{uri}
		reverse_proxy app:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy app:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {client_ip}
			transport http {
				read_timeout 2h
				write_timeout 2h
			}
		}
	}
}
