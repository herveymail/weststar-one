# Copy to .env and fill in. Never commit .env.
# ── For docker compose ──
DOMAIN=one.weststarmsp.com
POSTGRES_PASSWORD=        # openssl rand -base64 24
# 32 random bytes: openssl rand -base64 32   — BACK THIS UP OFFLINE. Losing it makes encrypted fields unreadable.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEYS_OLD=

# ── Only when running without docker ──
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://weststar:CHANGE_ME@127.0.0.1:5432/weststar
APP_URL=https://one.weststarmsp.com
TRUST_PROXY=true
SERVE_WEB=true
LOG_LEVEL=info
