# Copy to .env and fill in. Never commit .env.

# Your web address (DNS must point at this server for HTTPS to work)
DOMAIN=one.weststarmsp.com

# Long random values:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Encrypts 2FA seeds, Wi-Fi passwords, SSN/bank fields and other secrets.
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# BACK THIS UP OFFLINE (password manager / printed in the safe). Lose it = lose those fields.
APP_ENCRYPTION_KEY=
# When rotating: put the previous key here (comma-separated) until everything is re-encrypted.
APP_ENCRYPTION_KEYS_OLD=

TIME_ZONE=America/Denver
MAX_UPLOAD_MB=25

# Only for importing from the old PHP app (values from its config/config.php). Remove after cutover.
OLD_APP_KEY=
OLD_ENCRYPTION_KEY=
