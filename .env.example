# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Postgres connection
DATABASE_URL=postgres://weststar:CHANGE_ME@127.0.0.1:5432/weststar
# The address people type in their browser (used for the security Origin check and cookies)
APP_URL=https://one.weststarmsp.com
# 32 random bytes: openssl rand -base64 32   — BACK THIS UP OFFLINE. Losing it makes secrets unreadable.
APP_ENCRYPTION_KEY=
# Old keys still accepted for decryption while rotating (comma separated). Usually empty.
APP_ENCRYPTION_KEYS_OLD=
# Set to true when running behind Caddy/Nginx/Cloudflare so the real client IP is used for rate limits
TRUST_PROXY=true
SERVE_WEB=true
LOG_LEVEL=info
