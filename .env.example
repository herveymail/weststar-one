# Weststar ONE settings. The setup wizard (sudo bash install.sh) writes this file for you.
# Never commit .env. Values are in single quotes and taken literally.

DOMAIN='one.weststarmsp.com'
TIME_ZONE='America/Denver'
MAX_UPLOAD_MB='25'

# Long random values:  python3 -c "import secrets; print(secrets.token_hex(40))"
SECRET_KEY=''
DB_PASSWORD=''

# Encrypts 2FA seeds, Wi-Fi passwords, SSN/bank fields and other secrets.
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# BACK THIS UP OFFLINE (password manager / printed in the safe). Lose it = lose those fields.
APP_ENCRYPTION_KEY=''
# When rotating: put the previous key here (comma-separated) until everything is re-encrypted.
APP_ENCRYPTION_KEYS_OLD=''

# Updates (update.sh)
UPDATE_REPO='herveymail/weststar-one'
UPDATE_BRANCH='main'

# Optional off-site backup copy (Wasabi or any S3)
BACKUP_S3_BUCKET=''
BACKUP_S3_KEY=''
BACKUP_S3_SECRET=''
BACKUP_S3_REGION='us-east-1'
BACKUP_S3_PREFIX='weststar-one'
BACKUP_S3_ENDPOINT='https://s3.us-east-1.wasabisys.com'

# Only for importing from the old PHP app (values from its config/config.php). Clear after cutover.
OLD_APP_KEY=''
OLD_ENCRYPTION_KEY=''
