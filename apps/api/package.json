{
  "name": "@ws/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "import:legacy": "tsx src/importer/cli.ts",
    "worker": "tsx src/jobs/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@node-rs/argon2": "2.0.2",
    "@ws/shared": "workspace:*",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.2",
    "mysql2": "3.15.3",
    "otplib": "12.0.1",
    "pg-boss": "10.3.3",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "zod": "3.25.76",
    "fastify-plugin": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
